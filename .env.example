# Copia este archivo a .env (no se sube al repositorio) y completa los valores.
# Todas son PUBLIC_ porque el sitio es estático: no pongas aquí secretos reales.

# Dirección a la que el formulario envía el correo (formulario de MailerLite, Brevo o Buttondown).
PUBLIC_FORM_ACTION=

# Token de Cloudflare Web Analytics (analítica sin cookies).
PUBLIC_CF_ANALYTICS_TOKEN=

# Enlace de compra del Kit Premium (Hotmart, Lemon Squeezy o Gumroad). Vacío = "Próximamente".
PUBLIC_PREMIUM_BUY_URL=

# Perfil de LinkedIn de Kevin y correo de contacto para Habeas Data.
PUBLIC_LINKEDIN_URL=
PUBLIC_CONTACT_EMAIL=
