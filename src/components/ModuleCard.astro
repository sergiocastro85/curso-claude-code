---
interface Props {
  slug: string;
  numero: number;
  titulo: string;
  objetivo: string;
  semana: number;
  premium?: boolean;
}
const { slug, numero, titulo, objetivo, semana, premium = false } = Astro.props;
---

<a
  href={`/curso/${slug}/`}
  class="block h-full no-underline text-text bg-surface border border-border rounded-lg p-6 hover:border-accent hover:text-text"
>
  <div class="flex items-start justify-between gap-2">
    <span class="font-title font-bold text-accent leading-none" style="font-size: var(--text-display)" aria-hidden="true"
      >{numero}</span
    >
    <span class="font-title text-xs text-muted border border-border rounded-sm px-2 py-1">
      {semana > 0 ? `Semana ${semana}` : 'Inicio'}
    </span>
  </div>
  <h3 class="font-title text-lg mt-4 mb-2">{titulo}</h3>
  <p class="text-muted text-sm m-0">{objetivo}</p>
  {premium && <p class="font-title text-xs text-accent mt-3 mb-0">Incluye extra Premium</p>}
</a>
