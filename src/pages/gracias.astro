---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

// Solo prometemos el correo de bienvenida si hay un servicio de email conectado.
const conServicio = Boolean(SITE.formAction);
---

<BaseLayout title="Gracias · Claude Code desde cero" description="Confirmación de suscripción." noindex>
  <div class="container py-12 grid gap-6" style="max-width: 48rem">
    {conServicio ? (
      <>
        <h1 class="font-title text-2xl m-0">Listo, revisa tu correo.</h1>
        <p class="m-0 text-muted">
          Te enviamos la bienvenida. Si no la ves en unos minutos, revisa la carpeta de spam.
        </p>
      </>
    ) : (
      <>
        <h1 class="font-title text-2xl m-0">Gracias por tu interés.</h1>
        <p class="m-0 text-muted">
          Todavía no estamos enviando correos, así que no guardamos tu dirección. El curso ya está disponible aquí mismo.
        </p>
      </>
    )}
    <div><a class="btn-primary" href="/curso/00-como-usar/">Ir al primer módulo</a></div>
  </div>
</BaseLayout>
